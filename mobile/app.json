{
  "expo": {
    "name": "Festiv",
    "slug": "festiv",
    "scheme": "festiv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8fafc",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.athierry.festiv",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Festiv a besoin de votre position pour partager votre localisation avec vos amis et vous guider vers eux."
      }
    },
    "android": {
      "package": "com.festiv.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Festiv a besoin d'accéder à vos photos pour choisir une image de couverture de festival."
        }
      ],
      [
        "react-native-maps",
        {
          "requestLocationPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Festiv a besoin de votre position pour partager votre localisation avec vos amis et vous guider vers eux."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b38264e-e682-4e01-a567-d35ade0de789"
      }
    }
  }
}
